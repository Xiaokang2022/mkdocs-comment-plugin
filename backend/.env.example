# 服务监听地址不在这里配置：它由启动命令的 --host / --port 决定。
# 本机反向代理前置时建议只监听回环地址：
#   python -m uvicorn main:app --host 127.0.0.1 --port 8000
# 容器内必须监听 0.0.0.0，否则端口映射不生效（Dockerfile 已如此）。

# 仅当部署在子路径反向代理下（如 /comments/）时填写，用于生成文档里的接口地址
MKC_ROOT_PATH=

# SQLite 数据库文件位置
MKC_DB_PATH=comments.db

# 允许的跨域来源，逗号分隔；生产环境请勿使用 *
MKC_CORS_ORIGINS=*
MKC_CORS_ALLOW_CREDENTIALS=0

# 内容限制
MKC_MAX_CONTENT_LENGTH=5000
MKC_MAX_AUTHOR_LENGTH=60
MKC_MAX_PAGE_LENGTH=512

# 限流：每个 IP 在 N 秒内最多 M 次写操作（发表评论 / 点赞）
MKC_RATE_LIMIT_REQUESTS=30
MKC_RATE_LIMIT_WINDOW=60

# 浏览量：每次页面访问都计数，此处仅用于阻止单个 IP 刷量
MKC_VIEW_RATE_LIMIT_REQUESTS=60
MKC_VIEW_RATE_LIMIT_WINDOW=60

# 允许评论者删除自己的评论（通过创建时下发的一次性令牌）
MKC_ALLOW_DELETE=1

# 管理员令牌，用于硬删除与审核（留空表示禁用）
MKC_ADMIN_TOKEN=

# 屏蔽词，逗号分隔
MKC_BLOCKED_WORDS=

# 是否信任反向代理头（Nginx / Caddy / Cloudflare 前置时开启）
MKC_TRUST_PROXY_HEADERS=0
MKC_PROXY_HEADER=X-Forwarded-For

# 昵称默认值：
#   anonymous  —— 留空时显示为 MKC_ANONYMOUS_NAME（推荐）
#   ip         —— 把访客 IP 当作昵称（旧行为）
#   其他任意值 —— 直接当作默认昵称
MKC_DEFAULT_AUTHOR=anonymous

# 留空昵称时显示的名字
MKC_ANONYMOUS_NAME=匿名用户

# 谁的名字旁边会标出 IP：
#   anonymous —— 只有未署名的评论（推荐）
#   always    —— 所有评论
#   never     —— 都不显示，也不会下发给前端
MKC_SHOW_AUTHOR_IP=anonymous

# 表情集合（逗号分隔）
MKC_COMMENT_REACTIONS=👍,❤️,😄,🎉,🚀
MKC_PAGE_REACTIONS=👍,❤️,😄,🎉,🚀
MKC_EMOJI_PICKER=👍,👎,❤️,🔥,🎉,😄,😁,😂,🤣,😊,🙏,👏,🤝,💯,✅,❌,🚀,✨,👀,🤔,😮,😢,😡,🥳

# Markdown 渲染扩展，必须与站点 mkdocs.yml 的 markdown_extensions 保持一致，
# 否则评论预览与页面渲染会不一样。
#
# 两种写法都支持：
#   1) 只需要扩展名时，直接逗号分隔
#   2) 扩展需要选项时，用 JSON 数组（就是 mkdocs.yml 那一块的直译）
#
# 留空则使用内置默认值，它已经对齐 demo/mkdocs.yml。注意不要启用 nl2br，
# 它会给每个换行插入 <br>，与站点不一致。
# MKC_MARKDOWN_EXTENSIONS=admonition,attr_list,def_list,footnotes,md_in_html,tables,toc,pymdownx.details,pymdownx.superfences,pymdownx.highlight,pymdownx.tabbed
# MKC_MARKDOWN_EXTENSIONS=["admonition", "attr_list", "def_list", "footnotes", "md_in_html", "tables", "toc", "pymdownx.details", "pymdownx.superfences", {"pymdownx.highlight": {"anchor_linenums": true}}, {"pymdownx.tabbed": {"alternate_style": true}}]
